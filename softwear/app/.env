# The API the site fetches: server.ts, the stand-in. A build for elsewhere sets API_BASE_URL in the
# environment or in .env.local (out of git), either of which wins over this file.
API_BASE_URL=http://127.0.0.1:8787
# Your Clerk instance's publishable key (Clerk Dashboard, API keys), whose session tokens server.ts accepts.
# modules/apple/Clerk.swift has the same key. Without one, no one is signed in.
CLERK_PUBLISHABLE_KEY=
